<Page
    x:Class="RectifyPad.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RectifyPad"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:classes="using:RectifyPad.Classes"
    mc:Ignorable="d"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True">

    <Page.Resources>
        <DataTemplate x:Key="TopicItemTemplate" x:DataType="classes:Topic">
            <Border Padding="12" Margin="0,4,0,4" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Text="{x:Bind Description, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,8"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind PageCount, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="pages" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{x:Bind CreationDateString, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="SettingsFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="LibraryShelfHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8,10,8"/>
        </Style>
        <Style x:Key="LibraryCanvasCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8,10,8"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
        <Style x:Key="LibraryCanvasCardSelectedStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8,10,8"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
        <Style x:Key="LibraryPrimaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="LibrarySecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="LibraryTertiaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>
        <Style x:Key="LibraryGhostCardStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,14"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="Outline"
                                       RadiusX="8"
                                       RadiusY="8"
                                       Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                       StrokeThickness="1"
                                       StrokeDashArray="4 3"
                                       Fill="Transparent"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Outline.Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Setter Target="Outline.Fill" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Outline.Fill" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Outline.Opacity" Value="0.45"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibraryCornerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,-1,0,1"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.45"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibraryAddCanvasButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,-1,0,1"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.45"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ColorChoiceTemplate">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="18" Height="18" CornerRadius="4" BorderThickness="1"
                        BorderBrush="#66000000" Background="{Binding Preview}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="CanvasEditorStyle" TargetType="local:Editor">
            <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/BeVietnamPro-SemiBold.ttf#Be Vietnam Pro"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="96"/>
            <Setter Property="Foreground" Value="#F6E7C1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="SelectionFlyout" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:Editor">
                        <Grid Background="Transparent">
                            <ScrollViewer x:Name="ContentElement"
                                          Background="Transparent"
                                          Margin="0"
                                          Padding="{TemplateBinding Padding}"
                                          AutomationProperties.AccessibilityView="Raw"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                          IsTabStop="False"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                          VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                          ZoomMode="Disabled"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Disabled"/>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"/>
                                    <VisualState x:Name="Focused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- App Title Bar for custom titlebar support -->
        <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Height="32" VerticalAlignment="Top" Background="Transparent" Canvas.ZIndex="10">
            <TextBlock x:Name="AppTitle" Text="RectifyPad" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </Grid>

        <!-- Left Pane: Topic List -->
        <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="0,32,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="16" Spacing="8">
                <Grid>
                    <TextBlock Text="Thư viện" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="OpenSettingsButton"
                            Content="&#xE713;"
                            FontFamily="{StaticResource SegoeFluentIcons}"
                            Width="32"
                            Height="32"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Click="OpenSettingsButton_Click"
                            ToolTipService.ToolTip="Settings"
                            Background="Transparent"
                            BorderThickness="0"/>
                </Grid>
                <Button Content="Kệ mới"
                        Click="NewShelfButton_Click"
                        HorizontalAlignment="Stretch"/>
                <TextBox x:Name="LibrarySearchBox"
                         PlaceholderText="Tìm kệ, canvas hoặc nội dung..."
                         TextChanged="LibrarySearchBox_TextChanged"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Padding="8,0,8,16" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="LibraryHost" Spacing="8"/>
            </ScrollViewer>
        </Grid>

        <!-- Right Pane: Settings bar + canvas -->
        <Grid Grid.Column="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,40,16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                            <StackPanel MinWidth="180" Spacing="0">
                                <TextBlock Text="Font" Style="{StaticResource SettingsFieldLabel}"/>
                                <ComboBox x:Name="FontFamilyCombo" HorizontalAlignment="Stretch" SelectionChanged="Formatting_Changed" SelectedIndex="0">
                                    <x:String>Be Vietnam Pro</x:String>
                                    <x:String>Cormorant Infant</x:String>
                                    <x:String>Fraunces</x:String>
                                    <x:String>Literata</x:String>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel MinWidth="88" Spacing="0">
                                <TextBlock Text="Size" Style="{StaticResource SettingsFieldLabel}"/>
                                <ComboBox x:Name="FontSizeCombo" HorizontalAlignment="Stretch" SelectionChanged="Formatting_Changed" SelectedIndex="3">
                                    <x:String>64</x:String>
                                    <x:String>72</x:String>
                                    <x:String>84</x:String>
                                    <x:String>96</x:String>
                                    <x:String>108</x:String>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel MinWidth="88" Spacing="0">
                                <TextBlock Text="Leading" Style="{StaticResource SettingsFieldLabel}"/>
                                <ComboBox x:Name="LineSpacingCombo" HorizontalAlignment="Stretch" SelectionChanged="Formatting_Changed" SelectedIndex="1">
                                    <x:String>1.0</x:String>
                                    <x:String>1.1</x:String>
                                    <x:String>1.25</x:String>
                                    <x:String>1.4</x:String>
                                    <x:String>1.6</x:String>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel MinWidth="110" Spacing="0">
                                <TextBlock Text="Weight" Style="{StaticResource SettingsFieldLabel}"/>
                                <ComboBox x:Name="FontWeightCombo" HorizontalAlignment="Stretch" SelectionChanged="Formatting_Changed" SelectedIndex="1">
                                    <x:String>Normal</x:String>
                                    <x:String>SemiBold</x:String>
                                    <x:String>Bold</x:String>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel MinWidth="110" Spacing="0">
                                <TextBlock Text="Align" Style="{StaticResource SettingsFieldLabel}"/>
                                <ComboBox x:Name="AlignmentCombo" HorizontalAlignment="Stretch" SelectionChanged="Formatting_Changed" SelectedIndex="1">
                                    <x:String>Left</x:String>
                                    <x:String>Center</x:String>
                                    <x:String>Right</x:String>
                                    <x:String>Justify</x:String>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel MinWidth="150" Spacing="0">
                                <TextBlock Text="Color" Style="{StaticResource SettingsFieldLabel}"/>
                                <ComboBox x:Name="TextColorCombo"
                                          HorizontalAlignment="Stretch"
                                          ItemTemplate="{StaticResource ColorChoiceTemplate}"
                                          SelectionChanged="Formatting_Changed"/>
                            </StackPanel>

                            <StackPanel MinWidth="168" Spacing="0">
                                <TextBlock Text="Nền" Style="{StaticResource SettingsFieldLabel}"/>
                                <ComboBox x:Name="BackgroundCombo"
                                          HorizontalAlignment="Stretch"
                                          ItemTemplate="{StaticResource ColorChoiceTemplate}"
                                          SelectionChanged="Formatting_Changed"/>
                            </StackPanel>

                            <StackPanel MinWidth="140" VerticalAlignment="Bottom">
                                <TextBlock Text="Frame" Style="{StaticResource SettingsFieldLabel}"/>
                                <ToggleSwitch x:Name="RoundedRectToggle"
                                              OnContent="Rounded"
                                              OffContent="Flat"
                                              Toggled="RoundedRectToggle_Toggled"
                                              IsOn="False"
                                              MinWidth="0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="16,0,0,0">
                        <Button x:Name="ExportButton"
                                Content="Export Photos"
                                Click="ExportButton_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Save each screen as a high-resolution PNG in a folder"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="CarouselHost" Grid.Row="1" SizeChanged="CarouselHost_SizeChanged">
                <ScrollViewer x:Name="CarouselScroller"
                              Margin="0,8,0,118"
                              Background="Transparent"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              ZoomMode="Disabled"
                              BringIntoViewOnFocusChange="False"
                              ViewChanged="CarouselScroller_ViewChanged">
                    <Canvas x:Name="CarouselTrack"/>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Spacing="8">
                    <Border x:Name="CanvasDock"
                            Padding="14,8,16,8"
                            CornerRadius="10"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            MinWidth="280"
                            HorizontalAlignment="Stretch">
                        <StackPanel x:Name="CanvasDockHost" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <CheckBox x:Name="ApplyAllCheckBox"
                                      Content="Cả trang"
                                      MinWidth="0"
                                      Checked="ApplyAllCheckBox_Changed"
                                      Unchecked="ApplyAllCheckBox_Changed"/>
                            <CheckBox x:Name="DecorativeModeCheckBox"
                                      Content="Decorative"
                                      MinWidth="0"
                                      Checked="DecorativeModeCheckBox_Changed"
                                      Unchecked="DecorativeModeCheckBox_Changed"/>
                            <ComboBox x:Name="WordHighlightCombo"
                                      MinWidth="128"
                                      PlaceholderText="Highlight"
                                      SelectedIndex="0"
                                      SelectionChanged="WordHighlightCombo_Changed">
                                <x:String>None</x:String>
                                <x:String>Marker</x:String>
                                <x:String>Pill</x:String>
                                <x:String>Frame</x:String>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                        <Button x:Name="PrevPageButton" Content="← Trang trước" Click="PrevPageButton_Click"/>
                        <TextBlock x:Name="PageIndicatorText"
                                   Text="Trang 1 / 1"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   MinWidth="120"
                                   TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <Button x:Name="NextPageButton" Content="Trang sau →" Click="NextPageButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <Canvas x:Name="ExportHost"
                        Width="1080"
                        Height="1920"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Opacity="0"
                        IsHitTestVisible="False"/>

                <Border x:Name="ExportOverlay"
                        Visibility="Collapsed"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="360">
                        <ProgressBar x:Name="ExportProgressBar" IsIndeterminate="False" Minimum="0" Maximum="1" Width="280"/>
                        <TextBlock x:Name="ExportStatusText" Text="Exporting photos..." HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
